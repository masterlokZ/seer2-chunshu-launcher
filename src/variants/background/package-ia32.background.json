{
  "appId": "com.chunshu.seer2launcher",
  "productName": "seer2-春树登陆器",
  "copyright": "Copyright © 2026 春树",
  "asar": true,
  "afterPack": "./afterPack.js",
  "files": [
    "**/*",
    "!build-obfuscate.js",
    "!README.md",
    "!*.bat",
    "!index.html",
    "!package-lock.json",
    "!node_modules/.cache/**",
    "!flash/**",
    "!generate-manifest.js",
    "!generate-manifest.bat",
    "!speedhook_ce_x64.dll",
    "!scanner-x64.exe",
    "!Seer2UClientFtrAtlasConverter-x64.exe",
    "!uclient-pet-extractor-x64.exe",
    "!dist-build/**",
    "!dist-build-dual/**"
  ],
  "directories": {
    "output": "dist-build"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      }
    ],
    "icon": "icon.ico",
    "artifactName": "seer2-春树登陆器-${version}-${arch}-背景板.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "seer2-春树登陆器",
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "deleteAppDataOnUninstall": false,
    "allowElevation": true,
    "include": "build/installer/delete-old-local-res.nsh"
  },
  "asarUnpack": [
    "**/scanner.ps1",
    "**/scanner-x86.exe",
    "**/speedhook_ce_ia32.dll",
    "**/speedhook/ce_injector.exe",
    "**/uclient-pet-extractor.exe",
    "**/Seer2UClientFtrAtlasConverter-x86.exe"
  ],
  "extraResources": [
    {
      "from": "flash",
      "to": "flash",
      "filter": [
        "**/*",
        "!**/pepflashplayer64*"
      ]
    },
    {
      "from": "local-res",
      "to": "../local-res",
      "filter": [
        "**/*",
        "!对战版by_春树.swf"
      ]
    }
  ]
}
